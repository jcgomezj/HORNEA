# Dominio y URL base de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp oficial de atención y pedidos B2B (+57 Colombia)
NEXT_PUBLIC_WHATSAPP_CONTACT=+573001234567

# PIN de acceso administrativo al panel /admin (4 a 8 dígitos)
NEXT_PUBLIC_ADMIN_PIN=1234
ADMIN_SECRET_PIN=1234

# -----------------------------------------------------------------------------
# Pasarela de Pagos: Wompi Colombia (Bancolombia)
# Obtén tus credenciales en: https://comercios.wompi.co
# -----------------------------------------------------------------------------
# Llave pública (segura para exponer en frontend)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_Q5yDA9xoKdePzhSGeVe9KStXglIL2x04

# Llave privada (solo backend / Server Actions / API Routes)
WOMPI_PRIVATE_KEY=prv_test_example_key_here

# Secreto de integridad (utilizado para generar la firma SHA256 en /api/wompi/create-checkout)
WOMPI_INTEGRITY_SECRET=test_integrity_example_secret_here

# Secreto para validación de eventos Webhook en /api/wompi/webhook
WOMPI_EVENTS_SECRET=test_events_example_secret_here

# Endpoint base de Wompi (Sandbox / Producción)
WOMPI_API_URL=https://sandbox.wompi.co/v1

